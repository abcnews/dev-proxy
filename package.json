{
  "name": "@abcnews/dev-proxy",
  "version": "1.3.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "tsdown src/index.ts --dts --sourcemap --format esm --watch",
    "build": "tsdown src/index.ts --dts --sourcemap --format esm",
    "test": "vitest run",
    "lint": "eslint src",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "size": "npm run build && size-limit",
    "analyze": "size-limit --why",
    "release": "np"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "author": "Simon Elvery",
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "1 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/esbuild-why": "^14.3.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "np": "^12.1.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
